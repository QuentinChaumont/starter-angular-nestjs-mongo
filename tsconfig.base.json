{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0",
    "types": ["*"],
    "paths": {
      "@org/frontend-auth": ["./libs/frontend/auth/src/index.ts"],
      "@org/frontend-consent": ["./libs/frontend/consent/src/index.ts"],
      "@org/frontend-core": ["./libs/frontend/core/src/index.ts"],
      "@org/frontend-dashboard": ["./libs/frontend/dashboard/src/index.ts"],
      "@org/frontend-design": ["./libs/frontend/design/src/index.ts"],
      "@org/frontend-feedback": ["./libs/frontend/feedback/src/index.ts"],
      "@org/frontend-i18n": ["./libs/frontend/i18n/src/index.ts"],
      "@org/frontend-ui": ["./libs/frontend/ui/src/index.ts"],
      "@org/frontend-features-admin-audit": [
        "./libs/frontend/features/admin-audit/src/index.ts"
      ],
      "@org/frontend-features-admin-roles": [
        "./libs/frontend/features/admin-roles/src/index.ts"
      ],
      "@org/frontend-features-admin-users": [
        "./libs/frontend/features/admin-users/src/index.ts"
      ],
      "@org/frontend-features-profile": [
        "./libs/frontend/features/profile/src/index.ts"
      ]
    }
  }
}
