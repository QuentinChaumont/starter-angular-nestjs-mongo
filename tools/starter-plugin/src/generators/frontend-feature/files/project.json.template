{
  "name": "<%= projectName %>",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/features/<%= fileName %>/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:frontend", "type:feature"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/test-output/jest/coverage"],
      "options": {
        "jestConfig": "libs/frontend/features/<%= fileName %>/jest.config.cts",
        "tsConfig": "libs/frontend/features/<%= fileName %>/tsconfig.spec.json",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
