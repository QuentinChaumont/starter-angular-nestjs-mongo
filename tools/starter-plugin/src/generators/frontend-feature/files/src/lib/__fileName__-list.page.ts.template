import { ChangeDetectionStrategy, Component, OnInit, inject } from '@angular/core';
import { MatButtonModule } from '@angular/material/button';
import {
  MatPaginatorModule,
  PageEvent,
} from '@angular/material/paginator';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { MatTableModule } from '@angular/material/table';
import { RouterLink } from '@angular/router';
import { <%= className %>Store } from './<%= fileName %>.store';

const PAGE_SIZE = 20;

@Component({
  selector: 'lib-<%= fileName %>-list',
  imports: [
    RouterLink,
    MatTableModule,
    MatPaginatorModule,
    MatProgressBarModule,
    MatButtonModule,
  ],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <section class="<%= fileName %>-list">
      <header>
        <h1><%= className %></h1>
<% if (crud) { -%>
        <a mat-flat-button color="primary" routerLink="new">New</a>
<% } -%>
      </header>

      @if (store.loading()) {
        <mat-progress-bar mode="indeterminate"></mat-progress-bar>
      }
      @if (store.error(); as error) {
        <p role="alert">{{ error }}</p>
      }

      <table mat-table [dataSource]="store.items()">
        <ng-container matColumnDef="name">
          <th mat-header-cell *matHeaderCellDef>Name</th>
          <td mat-cell *matCellDef="let row">{{ row.name }}</td>
        </ng-container>
        <ng-container matColumnDef="actions">
          <th mat-header-cell *matHeaderCellDef></th>
          <td mat-cell *matCellDef="let row">
            <a mat-button [routerLink]="[row.id]">View</a>
<% if (crud) { -%>
            <a mat-button [routerLink]="[row.id, 'edit']">Edit</a>
<% } -%>
          </td>
        </ng-container>
        <tr mat-header-row *matHeaderRowDef="columns"></tr>
        <tr mat-row *matRowDef="let row; columns: columns"></tr>
      </table>

      @if (store.isEmpty()) {
        <p class="<%= fileName %>-list__empty">Nothing here yet.</p>
      }

      <mat-paginator
        [length]="store.total()"
        [pageSize]="pageSize"
        [pageSizeOptions]="[10, 20, 50]"
        (page)="onPage($event)"
      ></mat-paginator>
    </section>
  `,
  styles: `
    .<%= fileName %>-list {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .<%= fileName %>-list header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .<%= fileName %>-list table {
      width: 100%;
    }
  `,
})
export class <%= className %>ListPage implements OnInit {
  protected readonly store = inject(<%= className %>Store);
  protected readonly pageSize = PAGE_SIZE;
  protected readonly columns = ['name', 'actions'];

  ngOnInit(): void {
    this.store.load({ page: 1, pageSize: this.pageSize });
  }

  protected onPage(event: PageEvent): void {
    this.store.load({ page: event.pageIndex + 1, pageSize: event.pageSize });
  }
}
