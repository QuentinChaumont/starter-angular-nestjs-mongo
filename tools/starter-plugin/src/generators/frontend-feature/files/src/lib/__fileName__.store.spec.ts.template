import { provideHttpClient } from '@angular/common/http';
import {
  HttpTestingController,
  provideHttpClientTesting,
} from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { API_BASE_URL } from '@org/frontend-core';
import { <%= className %>Store } from './<%= fileName %>.store';

describe('<%= className %>Store', () => {
  let store: <%= className %>Store;
  let http: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [
        provideHttpClient(),
        provideHttpClientTesting(),
        { provide: API_BASE_URL, useValue: '/api' },
      ],
    });
    store = TestBed.inject(<%= className %>Store);
    http = TestBed.inject(HttpTestingController);
  });

  afterEach(() => http.verify());

  it('populates items + total on load', () => {
    store.load();
    http.expectOne('/api/<%= fileName %>').flush({
      items: [{ id: '1', name: 'a' }],
      total: 1,
      page: 1,
      pageSize: 20,
    });

    expect(store.items()).toHaveLength(1);
    expect(store.total()).toBe(1);
    expect(store.loading()).toBe(false);
  });

  it('surfaces an error and stops loading', () => {
    store.load();
    http
      .expectOne('/api/<%= fileName %>')
      .flush('boom', { status: 500, statusText: 'Server Error' });

    expect(store.error()).not.toBeNull();
    expect(store.loading()).toBe(false);
  });
});
