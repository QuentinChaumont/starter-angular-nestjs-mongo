# Copy to .env for local dev (loaded by @nestjs/config, and by Nx into every
# task's environment). Keep only backend-relevant keys here.
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200

# Backend HTTP port (defaults to 3000). Nx also injects this file into
# `nx serve frontend`, but apps/frontend/.env pins the SPA to 4200 so they
# don't collide.
PORT=3000

# Mongo brick
MONGO_URI=mongodb://localhost:27017/starter

# Auth brick
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_SECURE=false
# Self-service /register + POST /api/auth/register. Defaults to on.
# AUTH_REGISTRATION_ENABLED=false
# Stricter rate limit for /auth/login + /auth/register (defaults: 10 / 60s).
# AUTH_RATE_LIMIT_LIMIT=10
# AUTH_RATE_LIMIT_TTL_SECONDS=60
# Bootstrap admin — `pnpm seed:admin` (idempotent).
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-Str0ng!

# auth-reset brick (forgot-password + email verification)
# AUTH_REQUIRE_VERIFIED_EMAIL=false   # true → login blocked until verified
# RESET_TOKEN_TTL_MINUTES=60
# VERIFICATION_TOKEN_TTL_HOURS=24
# VERIFICATION_RESEND_COOLDOWN_SECONDS=300  # per-account "resend email" delay

# Mailer brick — console transport by default (logs + writes .eml previews
# under MAIL_PREVIEW_DIR). Set SMTP_URL (and `pnpm add nodemailer`) for real
# delivery; point it at Mailpit/Ethereal in dev.
# SMTP_URL=smtp://user:pass@localhost:1025
# MAIL_FROM=no-reply@localhost
# MAIL_PREVIEW_DIR=tmp/mail

# OIDC (optional — leave unset to disable). The built-in provider id is
# `generic`; its routes live under /api/auth/oidc/generic/*.
# OIDC_ISSUER=https://your-keycloak/realms/xyz
# OIDC_CLIENT_ID=starter
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/generic/callback
# OIDC_FRONTEND_URL=http://localhost:4200

# Google sign-in preset — issuer + scopes are fixed, you only supply the
# OAuth client (Google Cloud Console → Credentials → "Web application").
# The callback origin is taken from OIDC_REDIRECT_URI, so set that too;
# declare .../api/auth/oidc/google/callback as an authorized redirect URI.
# OIDC_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# OIDC_GOOGLE_CLIENT_SECRET=xxxxx
